{
  "policy": "project_theseus_openai_compat_policy_v0",
  "enabled": true,
  "purpose": "Expose a local OpenAI-compatible HTTP shim so agent harnesses can point at Project Theseus without using external inference.",
  "paths": {
    "local_config": "configs/openai_compat.local.json",
    "status": "reports/openai_compat_status.json",
    "events": "reports/openai_compat_events.jsonl",
    "last_chat": "reports/openai_compat_last_chat.json"
  },
  "defaults": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8789,
    "model": "theseus-live",
    "checkpoint_id": "live",
    "allow_teacher": false,
    "accept_any_model": true,
    "require_token": true,
    "api_token": "",
    "cors": false,
    "allowed_origins": [
      "http://127.0.0.1:8789",
      "http://localhost:8789"
    ],
    "max_request_body_bytes": 1048576,
    "max_concurrent_requests": 4,
    "max_requests_per_minute_per_client": 60,
    "resident_neural_seed": {
      "enabled": false,
      "model_id": "theseus-neural-seed",
      "target_id": "shared_trunk",
      "project_selected_quality_token_cap": null,
      "generation_boundary": "training_base_config.tokenization.max_sequence_tokens_minus_exact_encoded_prompt_tokens",
      "request_max_tokens_semantics": "optional_caller_constraint_not_capability_evidence",
      "beam_width": 2,
      "branching_factor": 2,
      "length_penalty": 0.6,
      "prefix_cache_entries": 32,
      "completion_cache_entries": 64,
      "identity_rehash_interval_seconds": 30,
      "continuous_batch_window_ms": 2.0,
      "maximum_request_batch_size": 8
    }
  },
  "security": {
    "loopback_only_by_default": true,
    "require_token_by_default": true,
    "allow_unauthenticated_loopback": false,
    "require_token_for_non_loopback": true,
    "cors_disabled_by_default": true,
    "exact_origin_allowlist_required": true,
    "never_call_external_inference": true,
    "teacher_disabled_by_default": true
  },
  "compatibility": {
    "base_url_hint": "http://127.0.0.1:8789/v1",
    "endpoints": [
      "GET /v1/models",
      "POST /v1/chat/completions",
      "POST /v1/completions",
      "GET /health"
    ]
  }
}
