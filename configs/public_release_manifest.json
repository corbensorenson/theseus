{
  "policy": "project_theseus_public_release_manifest_v1",
  "description": "Defines which repo paths are not allowed in the public source repository. Local copies may exist on a developer machine, but they must not be tracked by git.",
  "require_public_visibility": true,
  "tracked_root_allowlist": [
    ".gitignore",
    ".github",
    "AGENTS.md",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "adapters",
    "android",
    "assets",
    "backup_manifests",
    "benchmarks",
    "bin",
    "configs",
    "conftest.py",
    "crates",
    "dashboard",
    "data",
    "deprecated",
    "docs",
    "examples",
    "ios",
    "memory",
    "native",
    "packaging",
    "pytest.ini",
    "requirements",
    "roadmap.md",
    "scripts",
    "src",
    "tests"
  ],
  "forbidden_tracked_prefixes": [
    "archive/",
    "checkpoints/",
    "deprecated/logs/legacy-run-logs/",
    "dist/",
    "logs/",
    "personality-documents/",
    "reports/",
    "resource_pantry/git/",
    "runtime/",
    "target/",
    "data/private_code_curriculum/",
    "data/old_project_benchmarks/cases/",
    "data/training_data/high_transfer/",
    "data/training_data/candidate_coverage/private_train/",
    "data/training_data/decoder_plan_ir/private_train/",
    "data/training_data/long_horizon_programming/private_train/",
    "data/training_data/open_code_pantry/private_train/",
    "data/training_data/open_conversation_pantry/private_train/",
    "data/training_data/open_conversation_pantry/samples/",
    "data/training_data/open_conversation_pantry/sts_streams/",
    "data/training_data/residual_code_curriculum/private_train/",
    "tests/fixtures/core_evidence_local_8b_hidden/",
    "tests/fixtures/core_evidence_qwen35_fresh_hidden/",
    "tests/fixtures/core_evidence_qwen35_fresh_v2_hidden/",
    "tests/fixtures/core_evidence_repository_stack_development_hidden/",
    "tests/fixtures/core_evidence_tmax_fresh_v1_hidden/"
  ],
  "forbidden_tracked_paths": [
    "data/public_blimp_train.jsonl",
    "data/public_blimp_eval.jsonl",
    "data/babylm_blimp_filtered_train.jsonl",
    "data/babylm_blimp_filtered_eval.jsonl",
    "data/training_sources/trace_fabric_capsule_candidates.jsonl",
    "data/training_sources/narrow_corpus_manifest_10m.json",
    "data/training_sources/narrow_corpus_manifest_ladder_v1.json",
    "configs/core_evidence_local_8b_qualification_evaluator.json",
    "configs/core_evidence_qwen35_fresh_qualification_evaluator.json",
    "configs/core_evidence_qwen35_fresh_v2_qualification_evaluator.json",
    "configs/core_evidence_repository_stack_development_evaluator.json",
    "configs/core_evidence_tmax_fresh_v1_qualification_evaluator.json",
    "configs/core_evidence_worker_v2_qualification_evaluator.json",
    "configs/neural_seed_57m_functional_utility_freeze.json",
    "configs/neural_seed_functional_utility.json",
    "configs/neural_seed_functional_utility_freeze.json",
    "configs/neural_seed_local_english_raters.json",
    "scripts/neural_seed_functional_cases.py",
    "scripts/neural_seed_functional_consumption.py",
    "scripts/neural_seed_functional_generate.py",
    "scripts/neural_seed_functional_utility.py",
    "scripts/neural_seed_functional_verifiers.py",
    "scripts/neural_seed_local_english_raters.py",
    "tests/test_neural_seed_functional_cases.py",
    "tests/test_neural_seed_functional_consumption.py",
    "tests/test_neural_seed_functional_utility.py",
    "tests/test_neural_seed_functional_verifiers.py",
    "tests/test_neural_seed_local_english_raters.py"
  ],
  "forbidden_suffixes": [
    ".app",
    ".ckpt",
    ".dmg",
    ".key",
    ".onnx",
    ".p12",
    ".pdb",
    ".pem",
    ".pfx",
    ".pkg",
    ".pt",
    ".pth",
    ".safetensors",
    ".zip"
  ],
  "large_file_soft_limit_bytes": 5242880,
  "allowed_large_file_prefixes": [
    "docs/reference/"
  ],
  "allowed_secret_literal_prefixes": [
    "android/TheseusHive/app/src/main/java/local/projecttheseus/hive/",
    "benchmarks/cards/",
    "configs/",
    "docs/",
    "scripts/",
    "crates/"
  ],
  "source_release": {
    "policy": "project_theseus_source_only_release_v1",
    "include_paths": [
      ".gitignore",
      "AGENTS.md",
      "Cargo.lock",
      "Cargo.toml",
      "LICENSE",
      "NOTICE",
      "README.md",
      "conftest.py",
      "pytest.ini",
      "roadmap.md"
    ],
    "include_prefixes": [
      ".github/",
      "adapters/",
      "android/",
      "assets/",
      "bin/",
      "configs/",
      "crates/",
      "dashboard/",
      "docs/",
      "examples/",
      "ios/",
      "memory/",
      "native/",
      "packaging/",
      "requirements/",
      "scripts/",
      "src/",
      "tests/"
    ],
    "exclude_paths": [
      "configs/checkpoint_backup_policy.json",
      "configs/checkpoint_retention_pins.json",
      "configs/narrow_corpus_pretraining_spine.json",
      "configs/runtime_paths.json",
      "configs/training_profiles_macos_local.json"
    ],
    "exclude_prefixes": [
      "configs/evaluation_history/",
      "docs/archive/",
      "docs/reference/",
      "tests/fixtures/theseus_assistant_p2a_online/",
      "tests/fixtures/theseus_assistant_p3_online/",
      "tests/fixtures/theseus_p4_online/",
      "tests/fixtures/theseus_p4r_online/",
      "tests/fixtures/theseus_p4s_online/"
    ],
    "exclude_suffixes": [
      ".docx",
      ".pdf"
    ],
    "maximum_file_bytes": 2097152,
    "maximum_total_bytes": 134217728,
    "required_paths": [
      ".github/workflows/ci.yml",
      "Cargo.toml",
      "LICENSE",
      "README.md",
      "configs/public_release_manifest.json",
      "requirements/theseus-py312-public-ci.txt",
      "scripts/public_release_audit.py"
    ]
  }
}
