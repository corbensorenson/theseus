{
  "policy": "project_theseus_resource_aware_training_segments_v2",
  "enabled": true,
  "require_ac_power": true,
  "require_low_power_mode_off": true,
  "disk_reserve": {
    "policy": "two_complete_checkpoint_transactions_v1",
    "training_config": "configs/moecot_language_arm_training.json",
    "complete_transactions_required": 2
  },
  "lineage_custody": {
    "policy": "project_theseus_append_only_training_segment_lineage_v1",
    "anchor": "configs/neural_seed_t1_lineage_anchor.json",
    "ledger_directory": "reports/neural_seed_training_campaign_lineage",
    "archive_before_and_after_receipts": true,
    "archive_child_and_host_guard_receipts": true,
    "require_contiguous_identity_before_launch": true,
    "manifest_written_last": true
  },
  "yield_after_segment_control": "runtime/control/neural_seed_yield_after_segment",
  "interactive_accelerator_process_patterns": [
    "moecot_language_arm_training.py --execute",
    "fresh_process_pretraining_qualification.py --execute",
    "selected_route_sustained_qualification.py --execute",
    "optimizer_update_efficiency_qualification.py --execute",
    "masked_structural_growth_qualification.py --execute",
    "progressive_sequence_length_qualification.py --execute"
  ],
  "segment_behavior": {
    "never_suspend_in_flight_metal_graph": true,
    "reevaluate_after_every_transactional_segment": true,
    "stop_launching_when_gate_closes": true,
    "atomic_checkpoint_before_yield": true
  }
}
