    "candidate_calls_after_registry_write": false,
    "archive_fetch_after_registry_write_only": true,
    "surface_consumption_count": 0,
    "serving_training_teacher_D2_or_book_promotion_authority": false
  },
  "maximum_inference": "A GREEN frozen registry proves only metadata-level eligibility, deterministic membership, source disjointness, and a before-fetch selection boundary. It does not prove archive materialization, parent failure, target pass, evaluator adequacy, candidate utility, mechanism efficacy, D1 qualification, serving, training, D2, or ASI Stack support."
